# Nusxa oling: cp .env.example .env  va qiymatlarni o'zgartiring.

PORT=4000

# Ilova nomi va loyiha egasi (login sahifasi va footerda ko'rinadi)
APP_NAME=Nasl Daraxti
OWNER_NAME=Hilola O'rozaliyeva

# Birinchi ishga tushirishda yaratiladigan ADMIN hisobi.
# ADMIN_PASSWORD bo'sh qoldirilsa, tasodifiy parol yaratilib konsolga bir marta chiqariladi.
ADMIN_NAME=Hilola O'rozaliyeva
ADMIN_EMAIL=siz@example.com
ADMIN_PASSWORD=

# Token imzosi uchun maxfiy kalit. Bo'sh bo'lsa, avtomatik yaratilib bazada saqlanadi.
# Ishlab chiqarishda uzun tasodifiy qiymat bering:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=

# Token amal qilish muddati (soat)
TOKEN_TTL_HOURS=12

# Ixtiyoriy: ma'lumotlar bazasi fayli va build qilingan frontend joylashuvi
# DB_PATH=./data/shajara.db
# CLIENT_DIST=../client/dist

# Ixtiyoriy: frontend boshqa domenda bo'lsa (odatda kerak emas)
# CORS_ORIGIN=http://localhost:5173
